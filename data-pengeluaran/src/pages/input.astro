---
export const prerender = false;

// src/pages/input.astro
import { supabase } from '../db/supabase.js';
import SearchableSelect from '../components/SearchableSelect.astro';
import '../styles/global.css';

// Header anti-cache agar data selalu realtime
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0');
Astro.response.headers.set('CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Netlify-CDN-Cache-Control', 'no-store');

// 1. Ambil daftar proyek untuk isi dropdown
const { data: projects } = await supabase
  .from('project') 
  .select('project_id, nama_project')
  .order('nama_project', { ascending: true });

// 2. Baca parameter ID dari URL jika dalam mode Edit (?id=...) atau default project (?project_id=...)
const url = new URL(Astro.request.url);
const editId = url.searchParams.get('id');
const defaultProjectId = url.searchParams.get('project_id');

let dataLama = null;
let isEdit = false;

if (editId && editId !== 'undefined') {
  isEdit = true;
  const targetId = parseInt(editId); 

  // Ambil detail data pengeluaran lama berdasarkan expense_id
  const { data, error } = await supabase
    .from('pengeluaran') 
    .select('*')
    .eq('expense_id', targetId) 
    .maybeSingle(); 
    
  if (!error && data) {
    dataLama = data;
  } else if (error) {
    console.error("Gagal mengambil data lama:", error.message);
  }
}

const activeProjectId = dataLama?.project_id || defaultProjectId || '';
---

<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{isEdit ? "Edit Pengeluaran" : "Input Pengeluaran"}</title>
</head>
<body class="bg-slate-100 min-h-screen flex flex-col items-center justify-center p-6 font-sans">

  <div class="bg-white p-8 rounded-2xl shadow-md border border-slate-200 w-full max-w-md mx-auto">
    <h2 class="text-2xl font-black text-slate-900 mb-6 text-center tracking-tight">
      {isEdit ? "✏️ Edit Pengeluaran Project" : "📝 Input Pengeluaran Project"}
    </h2>

    <form id="expenseForm" class="space-y-4">
      
      <input type="hidden" id="edit_id" value={editId || ''} />
      
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Pilih Proyek *</label>
        <SearchableSelect
          id="project_id"
          name="project_id"
          options={projects?.map((project) => ({ value: project.project_id, label: project.nama_project })) || []}
          selectedValue={activeProjectId}
          placeholder="-- Pilih Proyek --"
          required={true}
        />
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Kategori Pengeluaran *</label>
        <select id="kategori" required class="w-full p-2.5 border border-gray-300 rounded-lg bg-white">
          <option value="">-- Pilih Kategori --</option>
          <option value="material" selected={dataLama?.kategori === 'material'}>📦 Material / Logistik</option>
          <option value="jasa" selected={dataLama?.kategori === 'jasa'}>🛠️ Jasa / Tukang / Subkon</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Tanggal *</label>
        <input type="date" id="date" required value={dataLama?.date || ''} class="w-full p-2.5 border border-gray-300 rounded-lg" />
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">PIC (Nama)</label>
        <input type="text" id="pic" value={dataLama?.pic || ''} placeholder="Contoh: Ujang" class="w-full p-2.5 border border-gray-300 rounded-lg" />
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Keterangan / Keperluan</label>
        <textarea id="keterangan" placeholder="Contoh: Pembelian Semen" rows="3" class="w-full p-2.5 border border-gray-300 rounded-lg">{dataLama?.keterangan || ''}</textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Jumlah Uang / Kredit (Rp) *</label>
        <input type="number" id="kredit" required min="0" value={dataLama?.kredit || ''} placeholder="Contoh: 1500000" class="w-full p-2.5 border border-gray-300 rounded-lg" />
      </div>

      <button type="submit" id="btnSubmit" class={`w-full text-white font-bold p-3 rounded-lg transition mt-4 ${isEdit ? 'bg-amber-500 hover:bg-amber-600' : 'bg-blue-600 hover:bg-blue-700'}`}>
        {isEdit ? "🔄 Update Pengeluaran" : "💾 Simpan Pengeluaran"}
      </button>
      
    </form>
  </div>

  <!-- Area Konfirmasi Riwayat Baru Diinput Sesi Ini -->
  <div id="recentSection" class="hidden mt-6 bg-white p-5 rounded-2xl shadow-sm border border-slate-200 w-full max-w-md mx-auto">
    <div class="flex items-center justify-between mb-3 border-b border-slate-100 pb-2">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">📋 Berhasil Diinput Sesi Ini</h3>
      <span id="recentCount" class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">0</span>
    </div>
    <div id="recentList" class="space-y-2 max-h-48 overflow-y-auto text-xs text-slate-700"></div>
  </div>

  <div class="mt-6">
    <a id="backLink" href={`/${activeProjectId ? `?project_id=${activeProjectId}` : ''}`} class="text-sm font-bold text-slate-500 hover:underline">
      ⬅️ Kembali ke Dashboard
    </a>
  </div>

  <script>
    const form = document.getElementById('expenseForm') as HTMLFormElement;
    const btnSubmit = document.getElementById('btnSubmit') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault(); 
      
      const editId = (document.getElementById('edit_id') as HTMLInputElement).value;
      const projectIdEl = document.getElementById('project_id') as HTMLInputElement;
      const projectIdVal = projectIdEl ? projectIdEl.value.trim() : '';

      // Validasi ketat di sisi client agar tidak mengirim data tanpa proyek
      if (!projectIdVal) {
        alert('⚠️ Silakan pilih proyek terlebih dahulu!');
        return;
      }

      const kreditEl = document.getElementById('kredit') as HTMLInputElement;
      const kreditVal = kreditEl ? kreditEl.value.trim() : '';
      if (!kreditVal || Number(kreditVal) <= 0) {
        alert('⚠️ Masukkan nominal uang / kredit yang valid (lebih dari 0)!');
        return;
      }

      const kategoriEl = document.getElementById('kategori') as HTMLSelectElement;
      if (!kategoriEl.value) {
        alert('⚠️ Silakan pilih kategori pengeluaran (Material atau Jasa)!');
        return;
      }

      const dateEl = document.getElementById('date') as HTMLInputElement;
      if (!dateEl.value) {
        alert('⚠️ Silakan pilih tanggal transaksi!');
        return;
      }

      btnSubmit.disabled = true;
      btnSubmit.innerText = editId ? 'Memperbarui...' : 'Menyimpan...';

      // Membaca isi inputan saat tombol ditekan oleh user
      const dataKirim = {
        id: editId ? editId : undefined, 
        project_id: projectIdVal,
        kategori: kategoriEl.value, 
        date: dateEl.value,
        pic: (document.getElementById('pic') as HTMLInputElement).value,
        keterangan: (document.getElementById('keterangan') as HTMLTextAreaElement).value,
        kredit: kreditVal
      };

      try {
        const response = await fetch('/api/function', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(dataKirim)
        });

        const hasil = await response.json();

        if (response.ok && hasil.success) {
          if (editId) {
            // MODE EDIT: Arahkan kembali ke dashboard proyek
            alert('🎉 Sukses! Perubahan data berhasil disimpan.');
            window.location.href = `/?project_id=${dataKirim.project_id}`; 
          } else {
            // MODE INPUT BARU: Tetap di halaman input data (tidak redirect ke dashboard)
            // Bersihkan kolom keterangan dan nominal, TETAP PERTAHANKAN PROYEK TERPILIH
            const ketEl = document.getElementById('keterangan') as HTMLTextAreaElement;
            if (ketEl) ketEl.value = '';
            if (kreditEl) kreditEl.value = '';

            // Update link kembali ke dashboard agar otomatis membawa ID proyek yang sedang aktif
            const backLink = document.getElementById('backLink') as HTMLAnchorElement;
            if (backLink) backLink.href = `/?project_id=${dataKirim.project_id}`;

            // Tampilkan visual di riwayat sesi ini
            const recentSection = document.getElementById('recentSection');
            const recentList = document.getElementById('recentList');
            const recentCount = document.getElementById('recentCount');
            if (recentSection && recentList && recentCount) {
              recentSection.classList.remove('hidden');
              const item = document.createElement('div');
              item.className = 'p-2.5 bg-emerald-50/80 border border-emerald-200 rounded-xl flex items-center justify-between';
              item.innerHTML = `
                <div>
                  <p class="font-bold text-slate-800">${dataKirim.keterangan || '(Tanpa keterangan)'}</p>
                  <p class="text-[11px] text-slate-500">${dataKirim.date} • ${dataKirim.kategori === 'material' ? '📦 Material' : '🛠️ Jasa'}${dataKirim.pic ? ` • PIC: ${dataKirim.pic}` : ''}</p>
                </div>
                <span class="font-mono font-bold text-emerald-700 text-xs">Rp ${Number(dataKirim.kredit).toLocaleString('id-ID')}</span>
              `;
              recentList.prepend(item);
              recentCount.textContent = String(recentList.children.length);
            }

            alert(`🚀 Sukses! Data pengeluaran ("${dataKirim.keterangan || '-'}") senilai Rp ${Number(dataKirim.kredit).toLocaleString('id-ID')} berhasil disimpan.`);
            if (ketEl) ketEl.focus();
          }
        } else {
          alert('❌ Gagal: ' + (hasil.message || 'Terjadi kesalahan server.'));
        }

      } catch (err: any) {
        alert('⚠️ Gagal Hubungan Koneksi: ' + err.message);
      } finally {
        btnSubmit.disabled = false;
        btnSubmit.innerText = editId ? 'Update Pengeluaran' : 'Simpan Pengeluaran';
      }
    });
  </script>
</body>
</html>