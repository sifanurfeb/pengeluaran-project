                id="btn-next-page"
                onclick="nextPage()"
                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 disabled:hover:bg-white text-xs font-bold text-slate-700 transition cursor-pointer disabled:cursor-not-allowed shadow-xs"
              >
                Berikutnya ➡️
              </button>
            </div>
          </div>
        </div>
      </>
    ) : (
      <div class="bg-white py-24 px-6 rounded-3xl border-2 border-dashed border-slate-200 text-center max-w-xl mx-auto mt-12 shadow-xs">
        <div class="w-16 h-16 bg-blue-50 text-blue-600 text-3xl flex items-center justify-center rounded-2xl mx-auto mb-4 font-bold shadow-inner">
          📊
        </div>
        <h2 class="text-xl font-extrabold text-slate-800 tracking-tight">Laporan Keuangan Kosong</h2>
        <p class="text-slate-400 text-sm max-w-sm mx-auto mt-2 leading-relaxed">
          Silakan gunakan menu *dropdown* di atas untuk memuat matriks profitabilitas dan tabel rincian transaksi proyek.
        </p>
      </div>
    )}

  </div>


<script>
  (window as any).hapusTransaksi = async (id: number) => {
    if (!confirm('Apakah Anda yakin ingin menghapus data transaksi pengeluaran ini secara permanen dari dashboard?')) return;

    try {
      const response = await fetch('/api/function', {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ id: id })
      });

      const hasil = await response.json();

      if (response.ok && hasil.success) {
        alert('🗑️ Sukses! Data transaksi berhasil dihapus.');
        window.location.reload();
      } else {
        alert('❌ Gagal Menghapus: ' + (hasil.message || 'Terjadi kesalahan internal.'));
      }
    } catch (err: any) {
      alert('⚠️ Gagal Hubungan Koneksi: ' + err.message);
    }
  };

  (window as any).currentKategori = 'semua';
  (window as any).currentSearch = '';
  (window as any).currentPage = 1;
  const ITEMS_PER_PAGE = 10;

  function renderPagination(totalItems: number, totalPages: number, curPage: number) {
    const container = document.getElementById('pagination-container');
    const infoEl = document.getElementById('pagination-info');
    const pageNumbersEl = document.getElementById('pagination-numbers');
    const prevBtn = document.getElementById('btn-prev-page') as HTMLButtonElement;
    const nextBtn = document.getElementById('btn-next-page') as HTMLButtonElement;

    if (!container) return;

    if (totalItems === 0) {
      container.classList.add('hidden');
      return;
    }

    container.classList.remove('hidden');

    const start = (curPage - 1) * ITEMS_PER_PAGE + 1;
    const end = Math.min(curPage * ITEMS_PER_PAGE, totalItems);
    if (infoEl) {
      infoEl.innerHTML = `Menampilkan <span class="font-bold text-slate-800">${start} - ${end}</span> dari <span class="font-bold text-slate-800">${totalItems}</span> transaksi`;
    }

    if (prevBtn) {
      prevBtn.disabled = curPage <= 1;
    }
    if (nextBtn) {
      nextBtn.disabled = curPage >= totalPages;
    }

    if (pageNumbersEl) {
      pageNumbersEl.innerHTML = '';

      for (let p = 1; p <= totalPages; p++) {
        if (totalPages > 7) {
          if (p !== 1 && p !== totalPages && Math.abs(p - curPage) > 1) {
            if (p === 2 && curPage > 3) {
              const dots = document.createElement('span');
              dots.className = 'px-1.5 py-1 text-slate-400 text-xs font-bold';
              dots.textContent = '...';
              pageNumbersEl.appendChild(dots);
            } else if (p === totalPages - 1 && curPage < totalPages - 2) {
              const dots = document.createElement('span');
              dots.className = 'px-1.5 py-1 text-slate-400 text-xs font-bold';
              dots.textContent = '...';
              pageNumbersEl.appendChild(dots);
            }
            continue;
          }
        }

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(p);
        btn.className = p === curPage
          ? 'w-8 h-8 flex items-center justify-center rounded-xl bg-blue-600 text-white font-bold text-xs shadow-xs transition cursor-default'
          : 'w-8 h-8 flex items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 hover:bg-slate-100 font-semibold text-xs transition cursor-pointer shadow-2xs';
        
        btn.onclick = () => {
          (window as any).goToPage(p);
        };
        pageNumbersEl.appendChild(btn);
      }
    }
  }

  (window as any).goToPage = (page: number) => {
    (window as any).currentPage = page;
    (window as any).applyFilters();
  };

  (window as any).prevPage = () => {
    if ((window as any).currentPage > 1) {
      (window as any).currentPage--;
      (window as any).applyFilters();
    }
  };

  (window as any).nextPage = () => {
    (window as any).currentPage++;
    (window as any).applyFilters();
  };

  (window as any).changeSort = (mode: string) => {
    const tbody = document.getElementById('expenseTbody');
    const emptyRow = document.getElementById('empty-search-row');
    if (!tbody) return;

    const rows = Array.from(tbody.querySelectorAll('.expense-row')) as HTMLElement[];

    rows.sort((a, b) => {
      if (mode === 'tanggal_terlama') {
        const dateA = a.dataset.date || '';
        const dateB = b.dataset.date || '';
        if (dateA !== dateB) return dateA.localeCompare(dateB);
        return Number(a.dataset.id || 0) - Number(b.dataset.id || 0);
      }
      if (mode === 'tanggal_terbaru') {
        const dateA = a.dataset.date || '';
        const dateB = b.dataset.date || '';
        if (dateA !== dateB) return dateB.localeCompare(dateA);
        return Number(b.dataset.id || 0) - Number(a.dataset.id || 0);
      }
      if (mode === 'nominal_terbesar') {
        return Number(b.dataset.nominal || 0) - Number(a.dataset.nominal || 0);
      }
      // Default: 'terbaru_input' (ID tertinggi di atas)
      return Number(b.dataset.id || 0) - Number(a.dataset.id || 0);
    });

    rows.forEach(r => tbody.appendChild(r));
    if (emptyRow) tbody.prepend(emptyRow);

    (window as any).currentPage = 1;
    (window as any).applyFilters();
  };

  (window as any).applyFilters = () => {
    const kategori = (window as any).currentKategori;
    const search = (window as any).currentSearch.toLowerCase().trim();
    const searchWords = search.split(/\s+/).filter(Boolean);
    const rows = document.querySelectorAll('.expense-row');

    const matchingRows: HTMLElement[] = [];

    rows.forEach((row: Element) => {
      const htmlRow = row as HTMLElement;
      const cocokKategori = kategori === 'semua' || htmlRow.dataset.kategori === kategori;

      const cells = htmlRow.querySelectorAll('td');
      const tanggal = (cells[0]?.textContent || '').toLowerCase();
      const kat = (cells[1]?.textContent || '').toLowerCase();
      const pic = (cells[2]?.textContent || '').toLowerCase();
      const keterangan = (cells[3]?.textContent || '').toLowerCase();
      const nominal = (cells[4]?.textContent || '').toLowerCase();

      // Pencarian multi-kata: semua kata pencarian harus ditemukan di baris
      const cocokSearch = searchWords.length === 0 || searchWords.every((w: string) => 
        pic.includes(w) || 
        keterangan.includes(w) || 
        nominal.includes(w) || 
        tanggal.includes(w) ||
        kat.includes(w)
      );

      if (cocokKategori && cocokSearch) {
        matchingRows.push(htmlRow);
      } else {
        htmlRow.style.display = 'none';
      }
    });

    const totalMatching = matchingRows.length;
    const totalPages = Math.ceil(totalMatching / ITEMS_PER_PAGE) || 1;

    if ((window as any).currentPage > totalPages) {
      (window as any).currentPage = totalPages;
    }
    if ((window as any).currentPage < 1) {
      (window as any).currentPage = 1;
    }

    const curPage = (window as any).currentPage;
    const startIndex = (curPage - 1) * ITEMS_PER_PAGE;
    const endIndex = startIndex + ITEMS_PER_PAGE;

    matchingRows.forEach((htmlRow, index) => {
      if (index >= startIndex && index < endIndex) {
        htmlRow.style.display = '';
      } else {
        htmlRow.style.display = 'none';
      }
    });

    const emptyRow = document.getElementById('empty-search-row');
    if (emptyRow) {
      if (rows.length > 0 && totalMatching === 0) {
        emptyRow.classList.remove('hidden');
      } else {
        emptyRow.classList.add('hidden');
      }
    }

    renderPagination(totalMatching, totalPages, curPage);
  };

  (window as any).filterKategori = (kategori: string) => {
    (window as any).currentKategori = kategori;
    (window as any).currentPage = 1;
    (window as any).applyFilters();

    // Update style tombol aktif
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.classList.remove('bg-slate-800', 'text-white', 'bg-amber-500', 'bg-purple-500');
      btn.classList.add('opacity-60');
    });

    const activeBtn = document.getElementById(`btn-${kategori}`);
    if (activeBtn) {
      activeBtn.classList.remove('opacity-60');
      if (kategori === 'semua') activeBtn.classList.add('bg-slate-800', 'text-white');
      if (kategori === 'material') activeBtn.classList.add('bg-amber-500', 'text-white');
      if (kategori === 'jasa') activeBtn.classList.add('bg-purple-500', 'text-white');
    }
  };

  (window as any).searchTransaksi = (value: string) => {
    (window as any).currentSearch = value;
    (window as any).currentPage = 1;
    (window as any).applyFilters();
  };

  (window as any).exportCSV = () => {
    const kategori = (window as any).currentKategori;
    const search = (window as any).currentSearch.toLowerCase().trim();
    const searchWords = search.split(/\s+/).filter(Boolean);
    const rows = document.querySelectorAll('.expense-row');
    const visibleRows: (string | number)[][] = [];

    // Header kolom
    visibleRows.push(['Tanggal', 'Kategori', 'PIC', 'Keterangan', 'Nominal (Kredit)']);

    rows.forEach((row: Element) => {
      const htmlRow = row as HTMLElement;
      const cocokKategori = kategori === 'semua' || htmlRow.dataset.kategori === kategori;

      const cells = htmlRow.querySelectorAll('td');
      const tanggal = cells[0]?.textContent?.trim() || '';
      const kat = cells[1]?.textContent?.trim() || '';
      const pic = cells[2]?.textContent?.trim() || '';
      const keterangan = cells[3]?.textContent?.trim() || '';
      const nominalText = cells[4]?.textContent?.trim() || '0';

      const cocokSearch = searchWords.length === 0 || searchWords.every((w: string) => 
        pic.toLowerCase().includes(w) || 
        keterangan.toLowerCase().includes(w) || 
        nominalText.toLowerCase().includes(w) || 
        tanggal.toLowerCase().includes(w) ||
        kat.toLowerCase().includes(w)
      );

      if (!cocokKategori || !cocokSearch) return;

      const nominalAngka = parseInt(nominalText.replace(/[^0-9-]/g, ''), 10) || 0;
      visibleRows.push([tanggal, kat, pic, keterangan, nominalAngka]);
    });

    const csvContent = visibleRows
      .map(row =>
        row
          .map((cell, i) =>
            typeof cell === 'number' ? cell : `"${String(cell).replace(/"/g, '""')}"`
          )
          .join(';')
      )
      .join('\n');

    const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `transaksi-${new Date().toISOString().slice(0, 10)}.csv`;
    link.click();
    URL.revokeObjectURL(url);
  };

  // Inisialisasi batas 10 baris dan pagination saat halaman dimuat
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => (window as any).applyFilters());
  } else {
    (window as any).applyFilters();
  }
</script>

<script define:vars={{ nilaiProjectVar: projectInfo?.nilai_project || 0, totalMaterialVar: totalMaterial, totalJasaVar: totalJasa, totalInvoiceTanpaPPNVar: totalInvoiceTanpaPPN }}>
  window.hitungUlangMargin = function(tanpaJasa) {
    var nilaiProject = Number(nilaiProjectVar);
    var totalMaterialJS = Number(totalMaterialVar);
    var totalJasaJS = Number(totalJasaVar);
    var totalInvoiceTanpaPPNJS = Number(totalInvoiceTanpaPPNVar);

    var costAktif = tanpaJasa ? totalMaterialJS : totalMaterialJS + totalJasaJS;

    // Margin vs PO
    var profitAktif = nilaiProject - costAktif;
    var marginAktif = nilaiProject > 0 ? (profitAktif / nilaiProject) * 100 : 0;

    // Margin vs Invoice
    var profitInvoiceAktif = totalInvoiceTanpaPPNJS - costAktif;
    var marginInvoiceAktif = totalInvoiceTanpaPPNJS > 0 ? (profitInvoiceAktif / totalInvoiceTanpaPPNJS) * 100 : 0;

    var formatRp = function(angka) {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(angka);
    };

    var elCost = document.getElementById('display-total-cost');
    var elCostBar = document.getElementById('display-total-cost-bar');
    var elProfit = document.getElementById('display-profit');
    var elMargin = document.getElementById('display-margin');
    var barCost = document.getElementById('bar-cost');
    var barProfit = document.getElementById('bar-profit');

    var elCostInvoice = document.getElementById('display-total-cost-invoice');
    var elProfitInvoice = document.getElementById('display-profit-invoice');
    var elMarginInvoice = document.getElementById('display-margin-invoice');

    if (elCost) elCost.textContent = formatRp(costAktif);
    if (elCostBar) elCostBar.textContent = formatRp(costAktif);
    if (elProfit) elProfit.textContent = formatRp(profitAktif);
    if (elMargin) elMargin.textContent = marginAktif.toFixed(1);
    if (barCost) barCost.style.width = Math.min((costAktif / (nilaiProject || 1)) * 100, 100).toFixed(1) + '%';
    if (barProfit) barProfit.style.width = Math.min(Math.abs(profitAktif / (nilaiProject || 1)) * 100, 100).toFixed(1) + '%';

    if (elCostInvoice) elCostInvoice.textContent = formatRp(costAktif);
    if (elProfitInvoice) elProfitInvoice.textContent = formatRp(profitInvoiceAktif);
    if (elMarginInvoice) elMarginInvoice.textContent = marginInvoiceAktif.toFixed(1);
  };
</script>
  
